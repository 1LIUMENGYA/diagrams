graph TD
    A[开始源域数据筛选] --> B[数据准备与分组];
    B --> C[建立32kHz与48kHz数据表格];
    C --> D[数据归一化处理];
    D --> E[计算48kHz数据理想故障频率];
    E --> F[提取实际故障频率];
    F --> G[计算频率误差];
    G --> H{误差≤0.2%?};
    H -->|是| I[保留数据];
    H -->|否| J[剔除数据];
    I --> K[初步筛选数据集];
    J --> K;
    K --> L[特征值提取];
    L --> M[与实际数据特征值对比];
    M --> N{特征匹配?};
    N -->|是| O[保留数据];
    N -->|否| P[剔除数据];
    O --> Q[最终筛选数据集];
    P --> Q;
    Q --> R[输出最终数据集];
    R --> S[结束];
    
    T[目标域数据<br>16个实际故障文件] --> M;
    
    subgraph 数据源
        U[源域数据<br>161个试验台文件]
        T
    end
    
    U --> B;
    
    style A fill:#e1f5fe
    style S fill:#f1f8e9
    style R fill:#fff3e0
    style T fill:#ffebee
    style U fill:#f3e5f5
